NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:CAMBIAR_PASSWORD@localhost:5432/dova
JWT_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=CAMBIAR_por_otro_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Orígenes extra que pueden usar la API, separados por coma (sin barra
# final). Las pantallas servidas por este mismo servidor siempre pueden.
# Sin definir = cualquiera (la API usa tokens, no cookies).
CORS_ORIGIN=http://localhost:8080
# Carpeta para fotos/estudios/adjuntos (en Render: /var/data/uploads, el disco persistente)
# UPLOADS_DIR=
# Huso horario de la clínica (define qué es "hoy")
# DOVA_TZ=America/Asuncion
# En Render (y la mayoría de Postgres gestionados) hace falta SSL. En
# desarrollo local contra localhost se deja sin setear.
# PGSSLMODE=require
# Opcional: contraseña inicial del usuario admin (si no se define es "admin" y DOVA obliga a cambiarla en el primer ingreso)
# ADMIN_PASSWORD=
