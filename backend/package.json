    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0"
  },
