{
  "name": "dova-backend",
  "version": "0.1.0",
  "description": "DOVA - Sistema de gestion odontologica. Backend API.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate:up": "node scripts/migrar.js up",
    "migrate:down": "node scripts/migrar.js down",
    "migrate:create": "node-pg-migrate create -m src/db/migrations",
    "seed": "node src/db/seed.js",
    "helpdesk:limpieza": "node src/jobs/limpiezaRetencionAdjuntos.js",
    "lint": "eslint .",
    "build": "node scripts/verificar-sintaxis.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
