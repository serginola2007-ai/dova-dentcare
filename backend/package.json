{
  "name": "dova-backend",
  "version": "0.1.0",
  "description": "DOVA - Sistema de gestion odontologica. Backend API.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:up": "node-pg-migrate up -m src/db/migrations",
    "migrate:down": "node-pg-migrate down -m src/db/migrations",
    "migrate:create": "node-pg-migrate create -m src/db/migrations",
    "seed": "node src/db/seed.js",
    "helpdesk:limpieza": "node src/jobs/limpiezaRetencionAdjuntos.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
